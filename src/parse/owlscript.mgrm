terminal_list owlscript.mlex
sp ::= PROG
PROG ::= STMTLIST
STMTLIST ::= STMT STMTLIST                                      @mkList
STMTLIST ::= STMT
STMT ::= EXPSTMT
STMT ::= IFSTMT
STMT ::= WHILESTMT
STMT ::= BLOCKSTMT
STMT ::= PRINTSTMT
STMT ::= LETSTMT
STMT ::= DEFSTMT
STMT ::= RETSTMT
STMT ::= STRUCTSTMT
PARAMLIST ::= DECLLIST
PARAMLIST ::= #
DECLSTMT ::= TK_LET TK_ID                                        @mkLet
DECLLIST ::= DECLSTMT TK_COMMA DECLLIST                          @mkList
DECLLIST ::= DECLSTMT
LETSTMT ::= TK_LET AEXPR TK_SEMI                                 @mkLet
PRINTSTMT ::= TK_PRINT AEXPR TK_SEMI                             @mkPrint
PRINTSTMT ::= TK_PRINTLN AEXPR TK_SEMI                           @mkPrint
BLOCKSTMT ::= TK_LCURLY STMTLIST TK_RCURLY                       @mkBlock
IFSTMT ::= TK_IF TK_LPAREN AEXPR TK_RPAREN BLOCKSTMT             @mkIf
WHILESTMT ::= TK_WHILE TK_LPAREN AEXPR TK_RPAREN BLOCKSTMT       @mkWhile
DEFSTMT ::= TK_FN TK_ID TK_LPAREN PARAMLIST TK_RPAREN BLOCKSTMT @mkFunc
STRUCTSTMT ::= TK_CLASS TK_ID BLOCKSTMT TK_SEMI                 @mkStruct
RETSTMT ::= TK_RETURN AEXPR TK_SEMI                              @mkRet
EXPSTMT ::= AEXPR TK_SEMI
AEXPR ::= COMPEXPR TK_ASSIGN AEXPR                               @binop
AEXPR ::= COMPEXPR TK_ASSIGN_SUM AEXPR                          @binop
AEXPR ::= COMPEXPR TK_ASSIGN_DIFF AEXPR                         @binop
AEXPR ::= COMPEXPR
COMPEXPR ::= COMPEXPR TK_EQU RELEXPR                            @binop
COMPEXPR ::= COMPEXPR TK_NEQ RELEXPR                            @binop
COMPEXPR ::= RELEXPR
RELEXPR ::= RELEXPR TK_LT EXPR                                  @binop
RELEXPR ::= RELEXPR TK_GT EXPR                                  @binop
RELEXPR ::= RELEXPR TK_GTE EXPR                                 @binop
RELEXPR ::= RELEXPR TK_LTE EXPR                                 @binop
RELEXPR ::= EXPR
EXPR ::= EXPR TK_ADD TERM                                       @binop
EXPR ::= EXPR TK_SUB TERM                                       @binop
EXPR ::= TERM
TERM ::= TERM TK_MUL FACT                                       @binop
TERM ::= TERM TK_DIV FACT                                       @binop
TERM ::= TERM TK_MOD FACT                                       @binop
TERM ::= FACT
FACT ::= TK_SUB POST                                            @unary
FACT ::= TK_NOT POST                                            @unary
FACT ::= POST
POST ::= POST TK_LB PRI TK_RB                               @mkSubscript
POST ::= POST TK_LPAREN ARGSLIST TK_RPAREN                      @mkCall
POST ::= POST TK_PERIOD PRI                                     @mkDotted
POST ::= POST TK_DECREMENT                                      @unary
POST ::= POST TK_INCREMENT                                      @unary
POST ::= PRI
PRI ::= TK_LPAREN AEXPR TK_RPAREN                               @pass
PRI ::= TK_NUM                                                  @mkNum
PRI ::= TK_ID                                                   @mkId
PRI ::= TK_STRING                                               @mkString
PRI ::= LISTCON
PRI ::= BLESSEXPR
PRI ::= LAMBDAEXPR
ARGSLIST ::= EXPLIST
ARGSLIST ::= #
EXPLIST ::= COMPEXPR TK_COMMA EXPLIST                         @mkList
EXPLIST ::= COMPEXPR
LISTCON ::= TK_LB ARGSLIST TK_RB                              @mkListCon
BLESSEXPR ::= TK_NEW TK_ID TK_LPAREN ARGSLIST TK_RPAREN       @mkInstance
LAMBDAEXPR ::= TK_LAMBDA PARAMLIST TK_RPAREN TK_PRODUCE STMT  @mkLambda