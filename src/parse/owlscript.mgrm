FORSTMT ::= TK_FOR TK_LPAREN OFEXPR TK_RPAREN BLOCKSTMT          @mkFor
OFEXPR ::= TK_ID TK_OF AEXPR                                     @mkOf
DEFSTMT ::= TK_FN TK_ID TK_LPAREN PARAMLIST TK_RPAREN BLOCKSTMT @mkFunc
STRUCTSTMT ::= TK_CLASS TK_ID BLOCKSTMT TK_SEMI                 @mkStruct
RETSTMT ::= TK_RETURN AEXPR TK_SEMI                              @mkRet
EXPSTMT ::= AEXPR TK_SEMI
