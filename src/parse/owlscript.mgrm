FACT ::= TK_NOT FEXPR                                            @unary
FACT ::= FEXPR
FEXPR ::= POST TK_PERIOD FEXPR                                  @mkDotted
FEXPR ::= POST
POST ::= POST TK_RANGE PRI                                      @binop
POST ::= POST TK_LB PRI TK_RB                                   @mkSubscript
POST ::= POST TK_LPAREN ARGSLIST TK_RPAREN                      @mkCall
POST ::= POST TK_DECREMENT                                      @unary
POST ::= POST TK_INCREMENT                                      @unary
POST ::= PRI
PRI ::= TK_LPAREN AEXPR TK_RPAREN                               @pass
PRI ::= TK_NUM                                                  @mkNum
PRI ::= TK_ID                                                   @mkId
PRI ::= TK_STRING                                               @mkString
PRI ::= TK_NIL                                              @mkConst
PRI ::= TK_TRUE                                             @mkConst
PRI ::= TK_FALSE                                            @mkConst
