def sorter(let xs) {
	def swap(let xs, let l, let r) {
		println "swapping " + xs[l] + " and " + xs[r];
		let tmp := xs[l]; 
		xs[l] := xs[r];
		xs[r] := tmp;
	}
	def sort(let xs) {
		println "sorting " + xs;
		let i := 0;
		let n := xs.size();
		while (i < n) {
			let j := n - 1;
			while (j > i) { 
					if (xs[i] > xs[j]) {
						swap(xs, i, j);
					} 
					j := j - 1;
			}
			i := i + 1;
		}
	}
	println "sort?";
	sort(xs);
}
let tmz := [86, 13, 19, 24, 11, 42, 8];
println tmz;
sorter(tmz);
println tmz;
