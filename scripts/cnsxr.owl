class Samp {
    let bell;
    let bang;
    def doit(let q) {
        return "lo"+q+this.bang;
    }
    def soy(let j) {
        return "hi"+j+this.bang;
    }
};
let xs := new Samp("Hello", "world");
let xz := new Samp("murlo", "lorum");
println xs.doit(" cruel ");
println xz.soy(13);
println xs.soy(xz.bang);
println xz.soy(true);
println xz.doit(xz.bell);